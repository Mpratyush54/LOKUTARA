{
  "name": "lokutara",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/competency-api",
    "apps/forum-api"
  ],
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "tsx watch server/index.ts",
    "dev:tests-api": "npm run serve -w @lokutara/competency-api",
    "dev:forum-api": "npm run dev -w @lokutara/forum-api",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "mongoose": "^8.16.1",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
