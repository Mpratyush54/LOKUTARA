# Admin login for /admin and /api/admin/* (httpOnly session cookie after login).
# Preferred: ADMIN_EMAIL + ADMIN_PASSWORD.
# Legacy: if ADMIN_EMAIL is unset, password-only login still works.
# Password resolution: ADMIN_PASSWORD, else ADMIN_DASHBOARD_SECRET (kept as fallback).
ADMIN_EMAIL=admin@lokutara.local
ADMIN_PASSWORD=change-me-local-only
# Optional legacy alias for the password when ADMIN_PASSWORD is unset:
# ADMIN_DASHBOARD_SECRET=change-me-local-only
PORT=3000
# Razorpay (admin invoices / payment links). Leave unset for draft + Record payment only.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Set true behind a reverse proxy so req.ip (rate limits) is correct. Defaults to true in production.
TRUST_PROXY=false
MONGODB_URI=mongodb://127.0.0.1:27017/lokutara
# Optional for local/dev. When unset or Redis is down, the app still boots;
# rate limits use in-memory buckets (fail-open if a configured Redis errors).
# REDIS_URL=redis://127.0.0.1:6379
# Optional: competency-mapping API (apps/competency-api, default port 3010)
# TESTS_API_URL=http://127.0.0.1:3010
# Optional: forum API (apps/forum-api, default port 5000)
# FORUM_API_URL=http://127.0.0.1:5000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
POSTHOG_KEY=
GA_MEASUREMENT_ID=
CLARITY_ID=
META_PIXEL_ID=
LINKEDIN_PARTNER_ID=
